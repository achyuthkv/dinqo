# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000          # public URL; used in payment links and webhooks
DATABASE_PATH=./data/dinqo.db
ADMIN_API_KEY=change-me                 # organiser console / API bearer token
DEV_TOOLS=true                          # WhatsApp simulator + fake payment pages; false in production

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PROVIDER=console               # console (local dev) | cloud
WHATSAPP_ACCESS_TOKEN=                  # system-user permanent token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                    # verifies X-Hub-Signature-256 on webhooks (required for cloud)
WHATSAPP_VERIFY_TOKEN=dinqo-verify      # must match the value entered in the Meta webhook config
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Payments (Razorpay) ---
PAYMENTS_PROVIDER=fake                  # fake (local dev) | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret

# --- Messaging policy ---
WEEKLY_INVITE_CAP=6                     # max polls + invites per player per rolling 7 days
CONSENT_POLICY_VERSION=2026-09
